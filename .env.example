# Copy to .env (`cp .env.example .env`). Never commit .env or real keys.
LLM_PROVIDER=offline                 # offline | openai (any OpenAI-compatible API)
LLM_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1   # Ollama: http://localhost:11434/v1
OPENAI_API_KEY=

MAX_AGENT_STEPS=6
MAX_TOOL_CALLS_PER_RUN=8
MAX_WRITE_ACTIONS_PER_RUN=2
TOOL_TIMEOUT_SECONDS=10
MAX_TOOL_OUTPUT_CHARS=4000

# Optional: real EAM API for operations tools (in-memory fake when unset)
# EAM_API_URL=http://localhost:9000/api/v1

# API key → principal. Development stand-in for OIDC tokens. Roles: viewer, technician, supervisor.
API_KEYS={"dev-tech-key-001": {"tenant": "acme", "user": "tara", "roles": ["technician"]}, "dev-supervisor-01": {"tenant": "acme", "user": "sam", "roles": ["supervisor"]}}
LOG_LEVEL=INFO
